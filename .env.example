# Upstream Hospital Directory API URL
HOSPITAL_API_BASE_URL=https://hospital-directory.onrender.com

# Processing Limits & Concurrency
CONCURRENCY_LIMIT=10
MAX_CSV_ROWS=20
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE=0.5

# HTTP Connection Pool Sizing
MAX_CONNECTIONS=50
MAX_KEEPALIVE_CONNECTIONS=20

# Application Metadata
APP_TITLE=Hospital Bulk Processing System
APP_VERSION=1.0.0
DEBUG=false

# Render Keep-Alive Heartbeat (pings every 10 min to prevent Render free-tier sleep)
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=600
SELF_PING_URL=

